    "@rocketseat/eslint-config": "^2.2.2",
    "@swc/core": "^1.15.33",
    "@types/express": "^5.0.0",
    "@types/node": "^24.12.2",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^8.57.1",
    "globals": "^17.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
