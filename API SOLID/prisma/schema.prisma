generator client {
  provider   = "prisma-client-js"
  output     = "./generated"
  engineType = "client"
}


datasource db {
  provider = "postgresql"
  
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  password_hash String
  created_at    DateTime  @default(now())
  checkIns      CheckIn[]

  @@map("users")
}

model Gym {
  id          String    @id @default(uuid())
  name        String
  description String?
  phone       String?
  latitude    Float
  longitude   Float
  checkIns    CheckIn[]

  @@map("gyms")
}

model CheckIn {
  id           String    @id @default(uuid())
  created_at   DateTime  @default(now())
  validated_at DateTime?

  user    User   @relation(fields: [user_id], references: [id])
  user_id String

  gym   Gym    @relation(fields: [gymId], references: [id])
  gymId String

  @@map("check_ins")
}
